# Non-secret systemd runtime configuration.
# Lighter credentials belong only in PERP_ENV_FILE, not in this file.
PERP_ENV_FILE=/etc/perp/robinhood.env
PERP_VENV=/opt/perp/.venv
PERP_TICKER=BTC
PERP_QUANTITY=0.00020
PERP_DIRECTION=buy
PERP_LIGHTER_LEVERAGE=2
PERP_SLIPPAGE=0.02
PERP_LIGHTER_MAX_WAIT=10
PERP_ASTER_MAKER_DEPTH=10

# The shipped service runs one cycle and exits successfully.
PERP_RUN_MODE=canary

# Continuous mode is blocked unless both values below are changed explicitly.
# PERP_RUN_MODE=continuous
# PERP_CONTINUOUS_ACK=I_ACKNOWLEDGE_CONTINUOUS_LIVE_TRADING
